# 仅服务端读取；不要放进 GitHub Pages、src、网页或公开仓库。
# 本地启动：node --env-file=.env server/flatlay-server.mjs
FLATLAY_PROVIDER=dashscope
DASHSCOPE_API_KEY=
FLATLAY_MODEL=qwen-image-edit-plus

# 可选专用 Photoroom Flat Lay：将提供方改为 photoroom 再填写密钥。
PHOTOROOM_API_KEY=

# 留空使用各提供方官方地址。可填写官方 API 基地址或完整路径。
# 百炼 Key 与北京/新加坡地域必须匹配。
# 新工作空间域名示例：https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com
FLATLAY_ENDPOINT=

# 多个完整 Origin 以逗号分隔；部署后加入实际 GitHub Pages 域名。
# 子路径不属于 Origin，例：https://ducky-yyds.github.io
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174,http://127.0.0.1:4175,http://localhost:4175

# 前端通过 X-Closet-Token 传递；本机可选，Worker/公网监听必须设置。
# 防止未经许可的付费调用。
FLATLAY_ACCESS_TOKEN=
FLATLAY_HOST=127.0.0.1
FLATLAY_PORT=8787

# 若官方返回额外的 OSS 存储桶，可加入精确域名；只接受阿里 OSS 域名。
# 默认支持官方动态 dashscope-<四位hex>.oss-accelerate / oss-cn-<region>，
# 以及旧 dashscope-result 存储桶；只下载公网 HTTPS，不允许重定向。
FLATLAY_RESULT_HOSTS=
