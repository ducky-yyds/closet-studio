{
  "name": "daily-wardrobe",
  "version": "1.0.0",
  "private": true,
  "description": "可以部署到 GitHub Pages 的本地电子衣柜",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --dir dist",
    "build": "node scripts/package.mjs",
    "test": "node --test tests/*.test.mjs deploy/fc/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:storage": "node scripts/storage-smoke.mjs",
    "vendor:ai": "node scripts/vendor-ai.mjs",
    "dev:api": "node --env-file-if-exists=.env server/flatlay-server.mjs",
    "fc:build": "node deploy/fc/build.mjs",
    "fc:deploy": "node --env-file-if-exists=.env deploy/fc/deploy.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2"
  }
}
